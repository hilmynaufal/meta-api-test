# Salin ke .env lalu sesuaikan. Jangan commit .env.
# Kredensial di bawah hanya untuk database dev lokal (docker-compose.yml).
DATABASE_URL="postgresql://siap_ppa:siap_ppa_dev@localhost:5434/siap_ppa"

# Rahasia penandatangan sesi, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Akun Admin awal untuk `npm run db:seed` (isi sendiri, jangan pakai kata sandi nyata).
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD=""
